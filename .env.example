# =============================================================================
# ZIPLINE — environment configuration
# Copy to .env and edit. Never commit .env. Never paste private keys anywhere else.
# =============================================================================

# ---- Mode --------------------------------------------------------------------
# LIVE_TRADING=false  -> DEMO MODE. Dry-run execution only. Nothing is ever broadcast.
# LIVE_TRADING=true   -> REAL ONCHAIN TRADES with REAL CAPITAL. Read README "Live mode" first.
LIVE_TRADING=false

# simulated -> a database-backed treasury for local development (DEMO MODE)
# onchain   -> balances read from the real treasury wallet over RPC.
#              With LIVE_TRADING=false this is read-only monitoring + dry-run planning.
TREASURY_MODE=simulated

# Seed cash for the *simulated* treasury only (ignored in onchain mode). Any amount.
DEMO_INITIAL_CASH=5000

# ---- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://zipline:zipline@localhost:5433/zipline
# Host port that Docker publishes Postgres on (the container always listens on 5432)
DB_PORT=5433

# ---- Robinhood Chain ----------------------------------------------------------
CHAIN_ID=4663
# Public RPC is rate-limited; use a dedicated endpoint for live trading.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_BASE_URL=https://robinhoodchain.blockscout.com

# Treasury / executor wallet. Use a DEDICATED wallet, never a personal one.
# The address is public and safe to share. The private key is not.
EXECUTOR_ADDRESS=
EXECUTOR_PRIVATE_KEY=

# Settlement asset the treasury holds and quotes against (USDG on Robinhood Chain).
CASH_TOKEN_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
CASH_TOKEN_SYMBOL=USDG

# ---- Robinhood Stock Token APIs (public, no key) ----------------------------
RH_STOCK_TOKEN_API_URL=https://api.robinhood.com/rhj

# Allowlist applied on top of the live Stock Token universe. Symbols must exist,
# be ACTIVE, deployed on CHAIN_ID, not halted, priced, and quotable to be traded.
ASSET_ALLOWLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AVGO,AMD,COST,XOM,SPY,QQQ,VTI,GLD,BND

# Candidate pairs for the PAIRS strategy (both legs must be eligible + correlated).
PAIRS_CANDIDATES=SPY:QQQ,SPY:VTI,AAPL:MSFT,GOOGL:META,NVDA:AMD

# ---- Execution provider (0x Swap API v2) ------------------------------------
ZEROX_API_URL=https://api.0x.org
ZEROX_API_KEY=

# ---- Historical underlying-equity data ----------------------------------------
# yfinance (dev default, unofficial Yahoo data) | stooq | polygon | alpaca | twelvedata
# Historical bars are UNDERLYING EQUITY prices, never Robinhood Chain prices.
HISTORY_PROVIDER=yfinance
HISTORY_LOOKBACK_DAYS=420
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
TWELVEDATA_API_KEY=

# ---- Schedule ---------------------------------------------------------------
# One cycle per completed regular NYSE session, at this Eastern time.
CYCLE_TIME_ET=16:20
VALUATION_INTERVAL_MIN=15
RECONCILE_INTERVAL_MIN=60
FUNDING_SCAN_INTERVAL_MIN=5

# ---- Capital & risk (all percentages are relative to treasury NAV) -----------
CASH_RESERVE_PCT=10
MAX_SINGLE_ASSET_PCT=20
MAX_STRATEGY_ALLOCATION_PCT=20
MAX_ORDER_PCT_OF_TREASURY=10
MAX_DAILY_TURNOVER_PCT=50
MIN_TRADE_NOTIONAL_PCT=0.25
MAX_SLIPPAGE_BPS=100
MAX_PRICE_IMPACT_BPS=150
MAX_FAILED_TXS_BEFORE_PAUSE=3
PRICE_STALENESS_SEC=120
QUOTE_STALENESS_SEC=30
MIN_GAS_ETH=0.002
RECONCILIATION_TOLERANCE_BPS=10

# Strategy status rules (drawdown from sleeve peak NAV)
WATCH_DRAWDOWN_PCT=10
DISABLE_DRAWDOWN_PCT=25

# ---- Gas pricing (for reporting gas cost in USD) ----------------------------
ETH_USD_PRICE_SOURCE=coinbase
CHAINLINK_ETH_USD_FEED=

# ---- Admin ----------------------------------------------------------------------
# Bearer token for POST /admin/* endpoints. Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-before-exposing-the-api

# ---- Optional: project token (never traded, never held by the treasury) --------
PROJECT_TOKEN_ADDRESS=

# ---- Web -------------------------------------------------------------------------
ENGINE_URL=http://localhost:8000
